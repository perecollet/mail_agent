# =====================================================================
# Mail Agent — environment configuration
#
#   cp .env.example .env && chmod 600 .env
#
# .env holds passwords and tokens: it is git-ignored and must never be committed.
# Write values without quotes. Variable names map to application.yaml through
# Spring's relaxed binding: MAILAGENT_SYNC_INTERVAL -> mailagent.sync.interval
# =====================================================================


# ---------------------------------------------------------------------
# PostgreSQL
# Read by both the postgres container and the application.
# ---------------------------------------------------------------------
POSTGRES_DB=mailagent
POSTGRES_USER=mailagent
# Generate one with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# Service name of the database in docker-compose. Use localhost when running the app from the IDE.
MAILAGENT_DB_HOST=postgres
# MAILAGENT_DB_PORT=5432


# ---------------------------------------------------------------------
# IMAP accounts (read-only)
#
# One block per account, numbered from 0 with no gaps.
#   ID         short name used in the index and by the agent: lowercase, digits, dashes
#   USERNAME   login; PASSWORD is an app-specific password, never your main password
#   ADDRESSES  every address that is "you" in this account, including aliases,
#              comma-separated. Used to tell sent from received email and for "unanswered".
#   FOLDERS    optional, default INBOX and the folder flagged as Sent by the server.
#              Only set it if the Sent folder is not detected; then use the real
#              name, e.g. MAILAGENT_ACCOUNTS_2_FOLDERS=INBOX,Enviados
# ---------------------------------------------------------------------

# Gmail · app password: https://myaccount.google.com/apppasswords (requires 2-Step Verification)
MAILAGENT_ACCOUNTS_0_ID=gmail
MAILAGENT_ACCOUNTS_0_HOST=imap.gmail.com
MAILAGENT_ACCOUNTS_0_PORT=993
MAILAGENT_ACCOUNTS_0_USERNAME=you@gmail.com
MAILAGENT_ACCOUNTS_0_PASSWORD=xxxxxxxxxxxxxxxx
MAILAGENT_ACCOUNTS_0_ADDRESSES=you@gmail.com

# iCloud · app-specific password: https://account.apple.com > Sign-In and Security
# Username: Apple recommends the name part only ("you"); the full address usually works too.
MAILAGENT_ACCOUNTS_1_ID=icloud
MAILAGENT_ACCOUNTS_1_HOST=imap.mail.me.com
MAILAGENT_ACCOUNTS_1_PORT=993
MAILAGENT_ACCOUNTS_1_USERNAME=you
MAILAGENT_ACCOUNTS_1_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Include @me.com / @mac.com aliases and the "Hide My Email" addresses you reply from.
MAILAGENT_ACCOUNTS_1_ADDRESSES=you@icloud.com,you@me.com

# Movistar · imap.movistar.es for @movistar.es, imap.telefonica.net for @telefonica.net
MAILAGENT_ACCOUNTS_2_ID=movistar
MAILAGENT_ACCOUNTS_2_HOST=imap.movistar.es
MAILAGENT_ACCOUNTS_2_PORT=993
MAILAGENT_ACCOUNTS_2_USERNAME=you@movistar.es
MAILAGENT_ACCOUNTS_2_PASSWORD=your-password
MAILAGENT_ACCOUNTS_2_ADDRESSES=you@movistar.es


# ---------------------------------------------------------------------
# Synchronizer (optional; defaults in application.yaml)
# ---------------------------------------------------------------------
# MAILAGENT_SYNC_ENABLED=true
# MAILAGENT_SYNC_INTERVAL=PT15M
# MAILAGENT_SYNC_INITIAL_WINDOW=P6M
# MAILAGENT_SYNC_RECONCILE_CRON=0 0 4 * * *
